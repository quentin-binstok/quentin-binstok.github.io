---
type IconName =
  | 'mail'
  | 'scholar'
  | 'github'
  | 'linkedin'
  | 'location'
  | 'building'
  | 'sun'
  | 'moon'
  | 'menu'
  | 'close'
  | 'arrow-left'
  | 'arrow-up-right'
  | 'chevron-right'
  | 'file';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className = 'size-4', label } = Astro.props;
const brand = name === 'github' || name === 'linkedin';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill={brand ? 'currentColor' : 'none'}
  stroke={brand ? 'none' : 'currentColor'}
  stroke-width={brand ? undefined : 1.6}
  stroke-linecap={brand ? undefined : 'round'}
  stroke-linejoin={brand ? undefined : 'round'}
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
>
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="m3.5 6.5 8.5 6 8.5-6" />
    </>
  )}
  {name === 'scholar' && (
    <>
      <path d="M22 10 12 5 2 10l10 5 10-5Z" />
      <path d="M6 12.2V17c0 1.6 2.7 2.9 6 2.9s6-1.3 6-2.9v-4.8" />
      <path d="M22 10v5" />
    </>
  )}
  {name === 'location' && (
    <>
      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
      <circle cx="12" cy="10" r="2.6" />
    </>
  )}
  {name === 'building' && (
    <>
      <path d="M4 21V4.5A1.5 1.5 0 0 1 5.5 3h8A1.5 1.5 0 0 1 15 4.5V21" />
      <path d="M15 9h3.5A1.5 1.5 0 0 1 20 10.5V21" />
      <path d="M2 21h20M7.5 7h4M7.5 11h4M7.5 15h4" />
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </>
  )}
  {name === 'moon' && <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5a8.5 8.5 0 1 0 10.6 10.6Z" />}
  {name === 'menu' && <path d="M3.5 7h17M3.5 12h17M3.5 17h17" />}
  {name === 'close' && <path d="m5 5 14 14M19 5 5 19" />}
  {name === 'arrow-left' && <path d="M20 12H4m0 0 6-6m-6 6 6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'chevron-right' && <path d="m9 18 6-6-6-6" />}
  {name === 'file' && (
    <>
      <path d="M14 2.8H6.5A1.5 1.5 0 0 0 5 4.3v15.4a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5-1.5V7.8Z" />
      <path d="M14 2.8v5h5M8.5 13h7M8.5 17h7" />
    </>
  )}
  {name === 'github' && (
    <path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.41-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
  )}
  {name === 'linkedin' && (
    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z" />
  )}
</svg>
