---
import NavLinks from './NavLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<aside class="hidden lg:block lg:sticky lg:top-0 lg:h-screen" aria-label="Sidebar">
  <div class="flex h-full flex-col justify-center pr-2">
    <a href="/" class="group mb-10 block">
      <span class="block font-mono text-[0.83rem] uppercase tracking-[0.16em] text-ink group-hover:text-accent">
        {site.name}
      </span>
      <span class="mt-1 block text-[0.75rem] leading-relaxed text-ink-faint">{site.role}</span>
    </a>

    <NavLinks pathname={pathname} />

    <div class="mt-10 flex items-center gap-2">
      <ThemeToggle />
    </div>

    <p class="mt-8 flex items-center gap-2 font-mono text-[0.64rem] uppercase tracking-[0.12em] text-ink-faint">
      <Icon name="location" class="size-3.5" />
      {site.location}
    </p>
  </div>
</aside>
